{
	"scripts": {
		"build:css": "sass src/scss:build/css --no-source-map --style=compressed",
		"build:js": "esbuild src/js/*.js --outdir=build/js --bundle --minify",
		"build:blocks": "wp-scripts build",
		"build": "npm-run-all build:*",
		"watch:css": "sass --watch src/scss:build/css",
		"watch:js": "esbuild src/js/*.js --outdir=build/js --bundle --watch",
		"watch:blocks": "wp-scripts start",
		"watch": "npm-run-all --parallel watch:*"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^15.8.0",
		"@wordpress/components": "^30.8.0",
		"@wordpress/element": "^6.35.0",
		"@wordpress/i18n": "^6.8.0",
		"@wordpress/scripts": "^31.0.0",
		"esbuild": "^0.25.0",
		"npm-run-all": "^4.1.5",
		"sass": "^1.93.2"
	}
}
